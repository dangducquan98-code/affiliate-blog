---
import BlogImage from './BlogImage.astro';
import { getCategoryLabel } from '../lib/categories';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  category: string;
  coverImage?: string | null;
}

const { href, title, description, date, category, coverImage } = Astro.props;
const dateLabel = date.toLocaleDateString('vi-VN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const categoryLabel = getCategoryLabel(category);
---

<li class="post-item">
  <a class="post-item__link" href={href}>
    {
      coverImage && (
        <div class="post-item__cover">
          <BlogImage src={coverImage} alt={title} width={800} quality={70} />
        </div>
      )
    }
    <div class="post-item__body">
      <p class="post-item__meta">
        {dateLabel}
        {categoryLabel && <> · <span class="post-item__cat">{categoryLabel}</span></>}
      </p>
      <h3 class="post-item__title">{title}</h3>
      <p class="post-item__desc">{description}</p>
    </div>
  </a>
</li>
