---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { listPublishedPosts } from '../../lib/posts';

const { posts, configured, error } = await listPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Bài viết làm TikTok kiếm tiền affiliate + review gear quay: hook, kịch bản, lộ trình 7 ngày, setup mic/đèn — Quân Kiu kể thật."
  canonicalPath="/blog"
>
  <section class="container">
    <PageHero
      title="Blog"
      lead="Bài để bạn làm được việc: viết hook, dựng kịch bản, bắt đầu affiliate, chọn mic/đèn khi cần — không catalogue bán hàng."
    />
    {
      error ? (
        <p class="fallback-notice">{error}</p>
      ) : posts.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state__title">Chưa có bài nào</p>
          <p>
            {configured
              ? 'Vào /admin để tạo bài hoặc publish.'
              : 'Supabase chưa cấu hình — danh sách bài sẽ xuất hiện sau khi điền env và import dữ liệu.'}
          </p>
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              date={new Date(post.created_at)}
              category={post.category}
              coverImage={post.cover_image}
            />
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
