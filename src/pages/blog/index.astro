---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { listPublishedPosts } from '../../lib/posts';

const { posts, configured, error } = await listPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Review, so sánh và hướng dẫn chọn gadget Shopee đáng tiền — củ sạc, hub, tai nghe, phụ kiện."
  canonicalPath="/blog"
>
  <section class="container">
    <h1>Blog</h1>
    <p style="color: var(--ink-muted); max-width: 36rem;">
      Review sâu, so sánh thật tay, hướng dẫn chọn đồ — viết cho người hay mua trên Shopee.
    </p>
    {
      error ? (
        <p class="fallback-notice" style="margin-top: 1.5rem;">{error}</p>
      ) : posts.length === 0 ? (
        <p class="fallback-notice" style="margin-top: 1.5rem;">
          {configured
            ? 'Chưa có bài published. Vào /admin để tạo bài hoặc publish.'
            : 'Supabase chưa cấu hình — danh sách bài sẽ xuất hiện sau khi điền env và import dữ liệu.'}
        </p>
      ) : (
        <ul class="post-list" style="margin-top: 1.5rem;">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              date={new Date(post.created_at)}
              category={post.category}
              coverImage={post.cover_image}
            />
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
