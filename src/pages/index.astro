---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { listPublishedPosts } from '../lib/posts';
import { getFeaturedDeals } from '../lib/deals';
import { BRAND_NAME } from '../lib/site';

const { posts, configured, error } = await listPublishedPosts(3);
const featuredDeals = getFeaturedDeals().slice(0, 3);
---

<BaseLayout
  title={BRAND_NAME}
  description="Review gadget Shopee thật tay — củ sạc, hub USB-C, tai nghe, phụ kiện dưới 800k. Nói rõ đáng mua hay không."
  canonicalPath="/"
>
  <section class="container hero">
    <h1 class="hero__brand">Quân Kiu <em>Daily</em></h1>
    <p class="hero__lead">
      Review gadget & phụ kiện công nghệ đáng tiền — sạc, hub, tai nghe, gậy selfie.
      Thật tay, nói thẳng, kèm deal đang chạy trên Shopee.
    </p>
    <div class="cta-row">
      <a class="btn btn--primary" href="/deals">Xem deal đang chạy</a>
      <a class="btn btn--ghost" href="/blog">Đọc review mới</a>
    </div>
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Bài mới</h2>
      <a href="/blog">Tất cả bài →</a>
    </div>
    {
      error ? (
        <p class="fallback-notice">{error}</p>
      ) : posts.length === 0 ? (
        <p class="fallback-notice">
          {configured
            ? 'Chưa có bài published. Đăng nhập /admin để viết bài hoặc chạy script migrate MDX.'
            : 'Supabase chưa cấu hình — blog sẽ hiển thị bài sau khi điền env thật và migrate dữ liệu.'}
        </p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              date={new Date(post.created_at)}
              category={post.category}
              coverImage={post.cover_image}
            />
          ))}
        </ul>
      )
    }
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Deal nổi bật</h2>
      <a href="/deals">Deal hub →</a>
    </div>
    <ul class="deal-list">
      {
        featuredDeals.map((deal) => (
          <li class="deal-item">
            <div class="deal-item__top">
              <h3 class="deal-item__name">{deal.name}</h3>
              <span class="deal-item__price">{deal.priceHint}</span>
            </div>
            <p class="deal-item__blurb">{deal.blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
