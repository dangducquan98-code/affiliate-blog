---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import DealItem from '../components/DealItem.astro';
import { listPublishedPosts } from '../lib/posts';
import { getFeaturedDeals } from '../lib/deals';
import { BRAND_NAME } from '../lib/site';

const { posts, configured, error } = await listPublishedPosts(3);
const featuredDeals = getFeaturedDeals().slice(0, 3);
---

<BaseLayout
  title={BRAND_NAME}
  description="Mình làm TikTok affiliate trên kênh quanh 4K follow — hook, kịch bản, lộ trình bắt đầu và gear đáng tiền. Quân Kiu kể thật, đọc trước mua sau."
  canonicalPath="/"
>
  <section class="container hero">
    <h1 class="hero__brand">Quân Kiu <em>Daily</em></h1>
    <p class="hero__lead">
      Mình làm TikTok affiliate — kênh quanh 4K follow, quay review và hướng dẫn mỗi tuần.
      Blog này là chỗ mình viết dài hơn video: hook, kịch bản, lộ trình từ đầu, và khi nào mới đáng
      mua mic/đèn. Đọc trước, mua sau — mình không hô mua mỗi ba giây.
    </p>
    <div class="cta-row">
      <a class="btn btn--primary" href="/blog">Đọc bài mới</a>
      <a class="btn btn--ghost" href="/categories">Chọn theo chủ đề</a>
    </div>
  </section>

  <section class="container">
    <article class="pillar-card">
      <p class="pillar-card__eyebrow">Bắt đầu từ đây</p>
      <h2 class="pillar-card__title">Làm TikTok affiliate từ 0</h2>
      <p class="pillar-card__desc">
        Bản đồ từ 0: chọn ngách, viết hook, quay clip ngắn, gắn link đúng chỗ. Chưa cần mua đồ quay
        cho đến khi bạn nắm được flow.
      </p>
      <a class="btn btn--primary" href="/blog/lam-tiktok-affiliate-tu-0">Đọc bản đồ từ 0 →</a>
    </article>
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Bài mới</h2>
      <a href="/blog">Tất cả bài →</a>
    </div>
    {
      error ? (
        <p class="fallback-notice">{error}</p>
      ) : posts.length === 0 ? (
        <p class="fallback-notice">
          {configured
            ? 'Chưa có bài published. Đăng nhập /admin để viết bài hoặc chạy script migrate MDX.'
            : 'Supabase chưa cấu hình — blog sẽ hiển thị bài sau khi điền env thật và migrate dữ liệu.'}
        </p>
      ) : (
        <ul class="post-list post-list--3">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              date={new Date(post.created_at)}
              category={post.category}
              coverImage={post.cover_image}
            />
          ))}
        </ul>
      )
    }
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Gear đang dùng</h2>
      <a href="/deals">Deal hub →</a>
    </div>
    <p style="color: var(--ink-muted); margin-top: -0.5rem;">
      Mic, đèn, tripod — món mình dùng thật và hay nhắc trên kênh. Đọc review trước, chốt mua khi
      đúng nỗi đau của bạn.
    </p>
    <ul class="deal-list">
      {
        featuredDeals.map((deal) => (
          <DealItem
            name={deal.name}
            blurb={deal.blurb}
            priceHint={deal.priceHint}
            goSlug={deal.goSlug}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
