---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import DealItem from '../components/DealItem.astro';
import { listPublishedPosts } from '../lib/posts';
import { getFeaturedDeals } from '../lib/deals';
import { BRAND_NAME } from '../lib/site';

const { posts, configured, error } = await listPublishedPosts(3);
const featuredDeals = getFeaturedDeals().slice(0, 3);
---

<BaseLayout
  title={BRAND_NAME}
  description="Quân Kiu ghi lại kinh nghiệm làm TikTok thật — thử, sai, sửa. Cho ai đang quay một mình."
  canonicalPath="/"
>
  <section class="container hero">
    <h1 class="hero__brand">Quân Kiu <em>Daily</em></h1>
    <p class="hero__lead">
      11h tối, ngồi cắt clip thứ ba trong tuần — view vẫn ì ạch. Mình không có công thức cứu view.
      Chỉ có những gì mình đã thử, sai, và sửa lại. Ghi ở đây cho ai đang ở đúng chỗ đó.

      MMO, tư duy, tài chính, sách hay — từ kênh TikTok ~4K và đời thường văn phòng.
      Không hứa giàu nhanh; chỉ chia sẻ cách mình đang làm thật. Đọc trước, mua sau.
    </p>
    <div class="cta-row">
      <a class="btn btn--primary" href="/blog">Đọc bài mới</a>
      <a class="btn btn--ghost" href="/categories">Chọn theo chủ đề</a>
    </div>
  </section>

  <section class="container">
    <article class="pillar-card">
      <p class="pillar-card__eyebrow">Bắt đầu từ đây · MMO</p>
      <h2 class="pillar-card__title">Làm TikTok affiliate từ 0</h2>
      <p class="pillar-card__desc">
        Lộ trình cho ai mới: chọn chủ đề, viết hook, quay clip ngắn, làm affiliate — theo thứ tự mình
        đã đi, không nhảy cóc.
      </p>
      <a class="btn btn--primary" href="/blog/lam-tiktok-affiliate-tu-0">Đọc bản đồ từ 0 →</a>
    </article>
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Bài mới</h2>
      <a href="/blog">Tất cả bài →</a>
    </div>
    {
      error ? (
        <p class="fallback-notice">{error}</p>
      ) : posts.length === 0 ? (
        <p class="fallback-notice">
          {configured
            ? 'Chưa có bài published. Đăng nhập /admin để viết bài hoặc chạy script migrate MDX.'
            : 'Supabase chưa cấu hình — blog sẽ hiển thị bài sau khi điền env thật và migrate dữ liệu.'}
        </p>
      ) : (
        <ul class="post-list post-list--3">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              date={new Date(post.created_at)}
              category={post.category}
              coverImage={post.cover_image}
            />
          ))}
        </ul>
      )
    }
  </section>

  <section class="container section">
    <div class="section__head">
      <h2>Setup đang dùng</h2>
      <a href="/deals">Xem thêm →</a>
    </div>
    <p style="color: var(--ink-muted); margin-top: -0.5rem;">
      Mic, đèn, tripod — mình note lại sau khi quay thật, để anh em tham khảo setup chứ không phải
      list mua sắm.
    </p>
    <ul class="deal-list">
      {
        featuredDeals.map((deal) => (
          <DealItem
            name={deal.name}
            blurb={deal.blurb}
            priceHint={deal.priceHint}
            goSlug={deal.goSlug}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
