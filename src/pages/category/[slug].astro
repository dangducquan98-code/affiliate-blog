---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getCategoryBySlug } from '../../lib/categories';
import { listPublishedPostsByCategory } from '../../lib/posts';

const slug = Astro.params.slug ?? '';
const category = getCategoryBySlug(slug);

if (!category) {
  Astro.response.status = 404;
}

const { posts, configured, error } = category
  ? await listPublishedPostsByCategory(category.slug)
  : { posts: [], configured: true, error: null };
---

{
  !category ? (
    <BaseLayout
      title="Không tìm thấy chủ đề"
      description="Chủ đề này không có trên blog."
      canonicalPath={`/category/${slug}`}
    >
      <section class="container">
        <div class="empty-state">
          <p class="empty-state__title">Không tìm thấy chủ đề</p>
          <p>Không có chủ đề này trên blog.</p>
        </div>
        <p style="margin-top: 1rem;">
          <a class="btn btn--ghost" href="/categories">← Tất cả chủ đề</a>
        </p>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={category.label}
      description={category.description}
      canonicalPath={`/category/${category.slug}`}
    >
      <section class="container">
        <Breadcrumb
          items={[
            { label: 'Trang chủ', href: '/' },
            { label: 'Chủ đề', href: '/categories' },
            { label: category.label },
          ]}
        />
        <PageHero title={category.label} lead={category.description} />
        {error ? (
          <p class="fallback-notice">{error}</p>
        ) : posts.length === 0 ? (
          <div class="empty-state">
            <p class="empty-state__title">Chưa có bài trong chủ đề này</p>
            <p>
              {configured
                ? 'Quay lại sau hoặc chọn chủ đề khác.'
                : 'Supabase chưa cấu hình — danh sách bài sẽ xuất hiện sau khi điền env.'}
            </p>
          </div>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <PostCard
                href={`/blog/${post.slug}`}
                title={post.title}
                description={post.description}
                date={new Date(post.created_at)}
                category={post.category}
                coverImage={post.cover_image}
              />
            ))}
          </ul>
        )}
      </section>
    </BaseLayout>
  )
}
