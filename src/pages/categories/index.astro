---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { CATEGORIES } from '../../lib/categories';
import { listPublishedPosts } from '../../lib/posts';

const { posts, error } = await listPublishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  counts.set(post.category, (counts.get(post.category) ?? 0) + 1);
}
---

<BaseLayout
  title="Chủ đề"
  description="Chọn nhanh bài muốn đọc: Làm TikTok, Affiliate & kiếm tiền, Review gear quay, AI & công cụ, Deal."
  canonicalPath="/categories"
>
  <section class="container">
    <PageHero
      title="Chủ đề"
      lead="Không biết bắt đầu bài nào? Chọn chủ đề khớp việc bạn đang cần — rồi vào list bài trong đó."
    />
    {
      error ? (
        <p class="fallback-notice">{error}</p>
      ) : (
        <ul class="category-list">
          {CATEGORIES.map((cat) => {
            const count = counts.get(cat.slug) ?? 0;
            return (
              <li class="category-item">
                <a href={`/category/${cat.slug}`}>
                  <div class="category-card__body">
                    <h2 class="category-card__title">{cat.label}</h2>
                    <p class="category-card__desc">{cat.description}</p>
                    <p class="category-card__meta">
                      {count === 0 ? 'Chưa có bài' : `${count} bài`}
                    </p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</BaseLayout>
