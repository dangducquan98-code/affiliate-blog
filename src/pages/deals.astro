---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DealItem from '../components/DealItem.astro';
import { getDeals } from '../lib/deals';

const deals = getDeals();
---

<BaseLayout
  title="Deal hub"
  description="Deal gear TikTok đang đẩy — mic, đèn, tripod. Giá chỉ khoảng tham khảo, check lại trên Shopee trước khi chốt."
  canonicalPath="/deals"
>
  <section class="container">
    <PageHero
      title="Deal đang chạy"
      lead="Danh sách món mình đang để ý / đang đẩy. Giá chỉ là khoảng tham khảo — vào Shopee check lại trước khi chốt."
    />
    <ul class="deal-list">
      {
        deals.map((deal) => (
          <DealItem
            name={deal.name}
            blurb={deal.blurb}
            priceHint={deal.priceHint}
            goSlug={deal.goSlug}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
