---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/admin-auth';
import { getClickStatsLast7Days } from '../../lib/click-events';
import { listAllPostsAdmin } from '../../lib/posts';
import { listProductsAdmin } from '../../lib/products';
import { isSupabaseServiceConfigured } from '../../lib/supabase';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

Astro.response.headers.set('Cache-Control', 'no-store');

const configured = isSupabaseServiceConfigured();
const { posts, error } = configured
  ? await listAllPostsAdmin()
  : {
      posts: [],
      error:
        'Supabase service role chưa cấu hình — CRUD sẽ hoạt động sau khi điền env thật.',
    };

const productsResult = configured
  ? await listProductsAdmin()
  : { products: [], error: null, tableMissing: false };

const clickStats = configured
  ? await getClickStatsLast7Days()
  : { total: 0, top: [], available: false, error: null };

const publishedCount = posts.filter((p) => p.published).length;
const draftCount = posts.length - publishedCount;
const productCount = productsResult.products.length;
const missingAffiliate = productsResult.products.filter((p) => !p.affiliate_url).length;

const postsJson = JSON.stringify(
  posts.map((p) => ({
    id: p.id,
    title: p.title,
    slug: p.slug,
    category: p.category,
    published: p.published,
    updated_at: p.updated_at,
  })),
);
---

<AdminLayout
  title="Bảng điều khiển"
  description="Quản trị Quân Kiu Daily"
  canonicalPath="/admin"
  activeNav="dashboard"
  wide={true}
>
  <p slot="lead">Tổng quan bài viết, sản phẩm và click affiliate 7 ngày.</p>
  <div slot="actions">
    <a class="btn btn--primary" href="/admin/posts/new">Bài mới</a>
    <a class="btn btn--ghost" href="/admin/products/new">Sản phẩm mới</a>
  </div>

  {error && <p class="fallback-notice">{error}</p>}

  {
    !error && (
      <div class="admin-stats admin-stats--5">
        <div class="admin-stat">
          <div class="admin-stat__value">{publishedCount}</div>
          <div class="admin-stat__label">Bài đã xuất bản</div>
        </div>
        <div class="admin-stat">
          <div class="admin-stat__value">{draftCount}</div>
          <div class="admin-stat__label">Bài nháp</div>
        </div>
        <div class="admin-stat">
          <div class="admin-stat__value">{productCount}</div>
          <div class="admin-stat__label">Tổng sản phẩm</div>
        </div>
        <div class="admin-stat">
          <div class="admin-stat__value">{missingAffiliate}</div>
          <div class="admin-stat__label">Chưa dán link</div>
        </div>
        <div class="admin-stat">
          <div class="admin-stat__value">{clickStats.available ? clickStats.total : '—'}</div>
          <div class="admin-stat__label">Click /go 7 ngày</div>
        </div>
      </div>
    )
  }

  {clickStats.error && <p class="fallback-notice">{clickStats.error}</p>}

  {
    clickStats.available && (
      <section class="admin-click-panel" aria-label="Top click /go 7 ngày">
        <div class="section__head" style="margin-bottom: 0.75rem;">
          <h2 style="margin: 0; font-size: 1.1rem;">Top slug /go (7 ngày)</h2>
          <span style="color: var(--ink-muted); font-size: 0.9rem;">
            Tổng {clickStats.total} click
          </span>
        </div>
        {clickStats.top.length === 0 ? (
          <p class="fallback-notice">Chưa có click nào trong 7 ngày.</p>
        ) : (
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Slug</th>
                  <th>Clicks</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {clickStats.top.map((row, i) => (
                  <tr>
                    <td>{i + 1}</td>
                    <td>
                      <code>{row.slug}</code>
                    </td>
                    <td>{row.count}</td>
                    <td>
                      <a class="btn btn--ghost" href={`/go/${row.slug}`} target="_blank" rel="noreferrer">
                        Test
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )
  }

  <section id="posts">
    <div class="section__head">
      <h2 style="margin: 0;">Bài viết</h2>
    </div>

    <div class="admin-toolbar">
      <input id="post-search" type="search" placeholder="Tìm theo tiêu đề…" autocomplete="off" />
      <select id="post-status-filter" aria-label="Lọc trạng thái">
        <option value="all">Tất cả trạng thái</option>
        <option value="published">Đã xuất bản</option>
        <option value="draft">Nháp</option>
      </select>
    </div>

    {
      !error && posts.length === 0 && (
        <p class="fallback-notice">
          Chưa có bài nào. <a href="/admin/posts/new">Tạo bài mới</a> hoặc chạy script migrate/rewrite.
        </p>
      )
    }

    {
      posts.length > 0 && (
        <div class="admin-table-wrap">
          <table class="admin-table" id="posts-table">
            <thead>
              <tr>
                <th>Tiêu đề</th>
                <th>Trạng thái</th>
                <th>Category</th>
                <th>Cập nhật</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="posts-tbody" data-posts={postsJson}></tbody>
          </table>
        </div>
      )
    }
    <p id="posts-empty-filter" class="fallback-notice" hidden>Không có bài khớp bộ lọc.</p>
  </section>
</AdminLayout>

<script>
  import { showToast, setLoading } from '../../scripts/admin-shared';

  type PostRow = {
    id: string;
    title: string;
    slug: string;
    category: string;
    published: boolean;
    updated_at: string;
  };

  const tbody = document.getElementById('posts-tbody');
  const searchEl = document.getElementById('post-search') as HTMLInputElement | null;
  const statusEl = document.getElementById('post-status-filter') as HTMLSelectElement | null;
  const emptyFilter = document.getElementById('posts-empty-filter');

  const allPosts: PostRow[] = tbody?.dataset.posts ? JSON.parse(tbody.dataset.posts) : [];

  function formatDate(iso: string): string {
    try {
      return new Date(iso).toLocaleString('vi-VN');
    } catch {
      return iso;
    }
  }

  function filtered(): PostRow[] {
    const q = (searchEl?.value || '').trim().toLowerCase();
    const status = statusEl?.value || 'all';
    return allPosts.filter((p) => {
      if (status === 'published' && !p.published) return false;
      if (status === 'draft' && p.published) return false;
      if (q && !p.title.toLowerCase().includes(q)) return false;
      return true;
    });
  }

  function render() {
    if (!tbody) return;
    const rows = filtered();
    if (emptyFilter) emptyFilter.hidden = rows.length > 0 || allPosts.length === 0;
    tbody.innerHTML = rows
      .map(
        (p) => `
      <tr data-id="${p.id}">
        <td>
          <a href="/admin/posts/${p.id}">${escapeHtml(p.title)}</a>
          <div class="admin-hint"><code>${escapeHtml(p.slug)}</code></div>
        </td>
        <td>
          <span class="admin-badge ${p.published ? 'admin-badge--ok' : 'admin-badge--muted'}">
            ${p.published ? 'Đã xuất bản' : 'Nháp'}
          </span>
        </td>
        <td>${escapeHtml(p.category || '—')}</td>
        <td>${formatDate(p.updated_at)}</td>
        <td>
          <div class="admin-table__actions">
            <a class="btn btn--ghost" href="/admin/posts/${p.id}">Sửa</a>
            <a class="btn btn--ghost" href="/blog/${escapeHtml(p.slug)}" target="_blank" rel="noreferrer">Xem</a>
            <button class="btn btn--danger" type="button" data-delete="${p.id}">Xoá</button>
          </div>
        </td>
      </tr>`,
      )
      .join('');
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  searchEl?.addEventListener('input', render);
  statusEl?.addEventListener('change', render);

  tbody?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-delete]') as HTMLButtonElement | null;
    if (!btn) return;
    const id = btn.dataset.delete || '';
    const post = allPosts.find((p) => p.id === id);
    if (!id || !confirm(`Xoá bài “${post?.title || id}” vĩnh viễn?`)) return;
    setLoading(btn, true, 'Đang xoá…');
    const res = await fetch(`/api/admin/posts/${id}`, { method: 'DELETE' });
    if (!res.ok) {
      setLoading(btn, false);
      showToast('Xoá thất bại.', 'err');
      return;
    }
    const idx = allPosts.findIndex((p) => p.id === id);
    if (idx >= 0) allPosts.splice(idx, 1);
    showToast('Đã xoá bài.');
    render();
  });

  render();
</script>
