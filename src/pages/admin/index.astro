---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/admin-auth';
import { getClickStatsLast7Days } from '../../lib/click-events';
import { listAllPostsAdmin } from '../../lib/posts';
import { listProductsAdmin } from '../../lib/products';
import { isSupabaseServiceConfigured } from '../../lib/supabase';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

Astro.response.headers.set('Cache-Control', 'no-store');

const configured = isSupabaseServiceConfigured();
const { posts, error } = configured
  ? await listAllPostsAdmin()
  : {
      posts: [],
      error:
        'Supabase service role chưa cấu hình — CRUD sẽ hoạt động sau khi điền env thật.',
    };

const productsResult = configured
  ? await listProductsAdmin()
  : { products: [], error: null, tableMissing: false };

const clickStats = configured
  ? await getClickStatsLast7Days()
  : { total: 0, top: [], available: false, error: null };

const publishedCount = posts.filter((p) => p.published).length;
const draftCount = posts.length - publishedCount;
const productCount = productsResult.products.length;
const missingAffiliateProducts = productsResult.products.filter((p) => !p.affiliate_url);
const missingAffiliate = missingAffiliateProducts.length;
const draftPosts = posts.filter((p) => !p.published).slice(0, 5);
---

<AdminLayout
  title="Bảng điều khiển"
  description="Quản trị Quân Kiu Daily"
  canonicalPath="/admin"
  activeNav="dashboard"
  wide={true}
>
  <p slot="lead">Tổng quan nhanh — việc cần làm trước, số liệu sau.</p>
  <div slot="actions">
    <a class="btn btn--primary" href="/admin/posts/new">Bài mới</a>
    <a class="btn btn--ghost" href="/admin/products/new">Sản phẩm mới</a>
  </div>

  {error && <p class="fallback-notice">{error}</p>}

  {
    !error && (missingAffiliate > 0 || draftCount > 0) && (
      <section class="admin-section" aria-label="Việc cần làm">
        <div class="admin-section__head">
          <h2 class="admin-section__title">Việc cần làm</h2>
        </div>
        <ul class="admin-todo-list">
          {missingAffiliate > 0 && (
            <li class="admin-todo-item admin-todo-item--warn">
              <p class="admin-todo-item__text">
                <strong>{missingAffiliate} sản phẩm chưa dán link affiliate</strong>
                Publish bài gắn SP sẽ bị chặn cho đến khi dán URL Shopee.
              </p>
              <a class="btn btn--primary" href="/admin/products?affiliate=empty">
                Dán link ngay
              </a>
            </li>
          )}
          {draftCount > 0 && (
            <li class="admin-todo-item">
              <p class="admin-todo-item__text">
                <strong>{draftCount} bài nháp</strong>
                Hoàn thiện nội dung và xuất bản khi sẵn sàng.
              </p>
              <a class="btn btn--ghost" href="/admin/posts?status=draft">
                Xem nháp
              </a>
            </li>
          )}
        </ul>
      </section>
    )
  }

  {
    !error && (
      <div class="admin-stats admin-stats--5">
        <a class="admin-stat" href="/admin/posts?status=published">
          <div class="admin-stat__value">{publishedCount}</div>
          <div class="admin-stat__label">Bài đã xuất bản</div>
        </a>
        <a class="admin-stat" href="/admin/posts?status=draft">
          <div class="admin-stat__value">{draftCount}</div>
          <div class="admin-stat__label">Bài nháp</div>
        </a>
        <a class="admin-stat" href="/admin/products">
          <div class="admin-stat__value">{productCount}</div>
          <div class="admin-stat__label">Tổng sản phẩm</div>
        </a>
        <a
          class:list={['admin-stat', missingAffiliate > 0 && 'admin-stat--warn']}
          href="/admin/products?affiliate=empty"
        >
          <div class="admin-stat__value">{missingAffiliate}</div>
          <div class="admin-stat__label">Chưa dán link</div>
        </a>
        <div class="admin-stat">
          <div class="admin-stat__value">{clickStats.available ? clickStats.total : '—'}</div>
          <div class="admin-stat__label">Click /go 7 ngày</div>
        </div>
      </div>
    )
  }

  {clickStats.error && <p class="fallback-notice">{clickStats.error}</p>}

  {
    clickStats.available && (
      <section class="admin-section admin-click-panel" aria-label="Top click /go 7 ngày">
        <div class="admin-section__head">
          <h2 class="admin-section__title">Top slug /go (7 ngày)</h2>
          <span class="admin-hint">Tổng {clickStats.total} click</span>
        </div>
        {clickStats.top.length === 0 ? (
          <p class="fallback-notice">Chưa có click nào trong 7 ngày.</p>
        ) : (
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Slug</th>
                  <th>Clicks</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {clickStats.top.map((row, i) => (
                  <tr>
                    <td>{i + 1}</td>
                    <td>
                      <code>{row.slug}</code>
                    </td>
                    <td>{row.count}</td>
                    <td>
                      <a class="btn btn--ghost" href={`/go/${row.slug}`} target="_blank" rel="noreferrer">
                        Test
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )
  }

  {
    missingAffiliateProducts.length > 0 && (
      <section class="admin-section">
        <div class="admin-section__head">
          <h2 class="admin-section__title">Sản phẩm thiếu affiliate</h2>
          <a class="btn btn--ghost" href="/admin/products?affiliate=empty">Xem tất cả</a>
        </div>
        <ul class="admin-todo-list">
          {missingAffiliateProducts.slice(0, 5).map((p) => (
            <li class="admin-todo-item admin-todo-item--warn">
              <p class="admin-todo-item__text">
                <strong>{p.name}</strong>
                <code>{p.slug}</code>
              </p>
              <a class="btn btn--primary" href={`/admin/products/${p.id}`}>
                Dán link
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    draftPosts.length > 0 && (
      <section class="admin-section">
        <div class="admin-section__head">
          <h2 class="admin-section__title">Bài nháp gần đây</h2>
          <a class="btn btn--ghost" href="/admin/posts?status=draft">Xem tất cả</a>
        </div>
        <ul class="admin-todo-list">
          {draftPosts.map((p) => (
            <li class="admin-todo-item">
              <p class="admin-todo-item__text">
                <strong>{p.title}</strong>
                <span class="admin-hint">Cập nhật {new Date(p.updated_at).toLocaleString('vi-VN')}</span>
              </p>
              <a class="btn btn--ghost" href={`/admin/posts/${p.id}`}>
                Tiếp tục sửa
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</AdminLayout>
