---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { requireAdmin } from '../../../lib/admin-auth';
import { productSlugOf } from '../../../lib/admin-posts';
import { getPostByIdAdmin } from '../../../lib/posts';
import { listProductsAdmin } from '../../../lib/products';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const id = Astro.params.id ?? '';
const { post, error } = await getPostByIdAdmin(id);
const { products: catalog, error: catalogError, tableMissing } = await listProductsAdmin();

if (!post && !error) {
  Astro.response.status = 404;
}

const selectedSlugs = post ? post.products.map(productSlugOf).filter(Boolean) : [];
const catalogJson = JSON.stringify(
  catalog.map((p) => ({
    slug: p.slug,
    name: p.name,
    price_hint: p.price_hint,
    has_affiliate: Boolean(p.affiliate_url),
  })),
);
const selectedJson = JSON.stringify(selectedSlugs);
const category = post?.category || 'huong-dan';
---

<BaseLayout
  title={post ? `Sửa: ${post.title}` : 'Không tìm thấy bài'}
  description="Sửa bài viết"
  canonicalPath={`/admin/posts/${id}`}
  hideChrome={true}
>
  <section class="admin-shell admin-shell--wide">
    {
      !post ? (
        <div>
          <h1>Không tải được bài</h1>
          <p class="fallback-notice">{error || 'Bài không tồn tại.'}</p>
          <a class="btn btn--ghost" href="/admin">
            ← Quay lại
          </a>
        </div>
      ) : (
        <>
          <div class="admin-bar">
            <div>
              <h1 style="margin: 0;">Sửa bài</h1>
              <p style="margin: 0.35rem 0 0; color: var(--ink-muted);">
                <a href={`/blog/${post.slug}`} target="_blank" rel="noreferrer">
                  Xem trên blog →
                </a>
                {' · '}
                <span class={`admin-badge ${post.published ? 'admin-badge--ok' : 'admin-badge--muted'}`}>
                  {post.published ? 'Đã xuất bản' : 'Nháp'}
                </span>
              </p>
            </div>
            <a class="btn btn--ghost" href="/admin">
              ← Quay lại
            </a>
          </div>
          <p id="error" class="admin-error" hidden></p>
          {(catalogError || tableMissing) && (
            <p class="fallback-notice">
              {catalogError ||
                'Bảng products chưa có — vẫn sửa được bài, gắn catalog sau khi migrate.'}
            </p>
          )}
          <form
            id="post-form"
            class="admin-form"
            data-id={post.id}
            data-published={post.published ? '1' : '0'}
          >
            <label>
              Tiêu đề *
              <input id="title" name="title" required value={post.title} />
            </label>
            <label>
              Slug (URL) *
              <input id="slug" name="slug" required value={post.slug} />
            </label>
            <label>
              Mô tả (SEO) *
              <textarea name="description" style="min-height: 5rem;" required>{post.description}</textarea>
            </label>
            <label>
              Category *
              <select id="category" name="category" data-current={category} required>
                <option value="huong-dan" selected={category === 'huong-dan'}>
                  Hướng dẫn
                </option>
                <option value="review" selected={category === 'review'}>
                  Review
                </option>
                <option value="so-sanh" selected={category === 'so-sanh'}>
                  So sánh
                </option>
                <option value="deal" selected={category === 'deal'}>
                  Deal / mua sắm
                </option>
              </select>
            </label>
            <label>
              Tags (phẩy)
              <input name="tags" value={post.tags.join(', ')} />
            </label>
            <label>
              Cover image path/URL
              <input name="cover_image" id="cover_image" value={post.cover_image ?? ''} />
            </label>
            <div class="admin-form__row">
              <input type="file" id="cover_file" accept="image/*" />
              <button class="btn btn--ghost" type="button" id="upload-cover">
                Upload ảnh cover
              </button>
            </div>
            <div id="cover-preview-wrap" class="admin-cover-preview" hidden>
              <img id="cover-preview" alt="Xem trước cover" />
            </div>

            <div class="admin-editor__meta">
              <div class="admin-editor__tabs">
                <button class="btn btn--ghost" type="button" id="tab-edit" aria-selected="true">
                  Soạn thảo
                </button>
                <button class="btn btn--ghost" type="button" id="tab-preview" aria-selected="false">
                  Xem trước
                </button>
                <button class="btn btn--ghost" type="button" id="tab-split" aria-selected="false">
                  Song song
                </button>
              </div>
              <span id="word-count" class="admin-hint">0 từ</span>
            </div>
            <p id="md-hint" class="admin-hint"></p>
            <div id="editor-panes" class="admin-editor__panes">
              <div id="edit-pane">
                <label>
                  Nội dung Markdown *
                  <textarea id="content" name="content" class="admin-editor__textarea" required>{post.content}</textarea>
                </label>
              </div>
              <div id="preview-pane" hidden>
                <div id="preview" class="admin-preview prose"></div>
              </div>
            </div>

            <div>
              <p style="font-weight: 600; margin: 0 0 0.5rem;">Sản phẩm từ catalog</p>
              <input
                id="product-search"
                type="search"
                placeholder="Tìm sản phẩm theo tên / slug…"
                style="margin-bottom: 0.65rem;"
              />
              <div
                id="products"
                class="admin-products-pick"
                data-catalog={catalogJson}
                data-selected={selectedJson}
              />
            </div>

            <input type="checkbox" name="published" checked={post.published} hidden />

            <div class="admin-form__actions">
              <button class="btn btn--ghost" type="button" id="save-draft">
                Lưu nháp
              </button>
              <button class="btn btn--primary" type="button" id="save-publish">
                Xuất bản
              </button>
              <button class="btn btn--ghost" type="button" id="unpublish">
                Huỷ xuất bản
              </button>
              <button class="btn btn--danger" type="button" id="delete-post">
                Xoá bài
              </button>
            </div>
          </form>

          <div class="admin-quick-product" style="margin-top: 1.25rem;">
            <p style="margin: 0; font-weight: 600;">Thêm sản phẩm nhanh</p>
            <p class="admin-hint">
              Tạo product mới và tự gắn vào bài đang sửa — không cần rời trang.
            </p>
            <div id="quick-product-form">
              <div class="admin-form__row">
                <input id="qp-name" placeholder="Tên sản phẩm" style="flex: 1.4;" />
                <input id="qp-slug" placeholder="slug (tuỳ chọn)" style="flex: 1;" />
                <input id="qp-category" placeholder="category" value="khac" style="flex: 0.8;" />
                <input id="qp-price" placeholder="Giá gợi ý" style="flex: 0.8;" />
                <input id="qp-aff" placeholder="Affiliate URL (tuỳ chọn)" style="flex: 1.2;" />
                <button class="btn btn--ghost" type="button" id="qp-submit">
                  Thêm
                </button>
              </div>
            </div>
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

{
  post && (
    <script>
      import { initPostEditor } from '../../../scripts/admin-post-editor';
      const form = document.getElementById('post-form') as HTMLFormElement | null;
      initPostEditor({
        mode: 'edit',
        postId: form?.dataset.id || '',
        initialPublished: form?.dataset.published === '1',
      });
    </script>
  )
}
