---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { CATEGORIES, DEFAULT_CATEGORY_SLUG } from '../../../lib/categories';
import { requireAdmin } from '../../../lib/admin-auth';
import { listProductsAdmin } from '../../../lib/products';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const { products: catalog, error: catalogError, tableMissing } = await listProductsAdmin();
const catalogJson = JSON.stringify(
  catalog.map((p) => ({
    slug: p.slug,
    name: p.name,
    price_hint: p.price_hint,
    has_affiliate: Boolean(p.affiliate_url),
  })),
);
---

<AdminLayout
  title="Viết bài mới"
  description="Tạo bài viết mới"
  canonicalPath="/admin/posts/new"
  activeNav="posts"
  wide={true}
>
  <div slot="actions">
    <a class="btn btn--ghost" href="/admin#posts">← Danh sách bài</a>
  </div>
  <p id="error" class="admin-error" hidden></p>
  <div id="publish-guard" class="admin-guard-banner" hidden></div>
    {
      (catalogError || tableMissing) && (
        <p class="fallback-notice">
          {catalogError ||
            'Bảng products chưa có — chạy migration rồi gắn sản phẩm từ catalog.'}
        </p>
      )
    }
    <form id="post-form" class="admin-form">
      <label>
        Tiêu đề *
        <input id="title" name="title" required />
      </label>
      <label>
        Slug (URL)
        <input id="slug" name="slug" placeholder="tu-dong-tu-tieu-de" />
      </label>
      <label>
        Mô tả (SEO) *
        <textarea name="description" style="min-height: 5rem;" required></textarea>
      </label>
      <label>
        Category *
        <select id="category" name="category" data-current={DEFAULT_CATEGORY_SLUG} required>
          {
            CATEGORIES.map((cat) => (
              <option value={cat.slug} selected={cat.slug === DEFAULT_CATEGORY_SLUG}>
                {cat.label}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        Tags (phẩy)
        <input name="tags" placeholder="tiktok, affiliate, review" />
      </label>
      <label>
        Cover image path/URL
        <input name="cover_image" id="cover_image" placeholder="ten-file.jpg hoặc URL" />
      </label>
      <div class="admin-form__row">
        <input type="file" id="cover_file" accept="image/*" />
        <button class="btn btn--ghost" type="button" id="upload-cover">Upload ảnh cover</button>
      </div>
      <div id="cover-preview-wrap" class="admin-cover-preview" hidden>
        <img id="cover-preview" alt="Xem trước cover" />
      </div>

      <div class="admin-editor__meta">
        <div class="admin-editor__tabs">
          <button class="btn btn--ghost" type="button" id="tab-edit" aria-selected="true">
            Soạn thảo
          </button>
          <button class="btn btn--ghost" type="button" id="tab-preview" aria-selected="false">
            Xem trước
          </button>
          <button class="btn btn--ghost" type="button" id="tab-split" aria-selected="false">
            Song song
          </button>
        </div>
        <span id="word-count" class="admin-hint">0 từ</span>
      </div>
      <p id="md-hint" class="admin-hint"></p>
      <div id="editor-panes" class="admin-editor__panes">
        <div id="edit-pane">
          <label>
            Nội dung Markdown *
            <textarea
              id="content"
              name="content"
              class="admin-editor__textarea"
              required
              placeholder="Viết Markdown thuần..."></textarea>
          </label>
        </div>
        <div id="preview-pane" hidden>
          <div id="preview" class="admin-preview prose"></div>
        </div>
      </div>

      <div>
        <p style="font-weight: 600; margin: 0 0 0.5rem;">Sản phẩm từ catalog</p>
        <input
          id="product-search"
          type="search"
          placeholder="Tìm sản phẩm theo tên / slug…"
          style="margin-bottom: 0.65rem;"
        />
        <div id="products" class="admin-products-pick" data-catalog={catalogJson} data-selected="[]"
        ></div>
      </div>

      <input type="checkbox" name="published" hidden />

      <div class="admin-form__actions">
        <button class="btn btn--ghost" type="button" id="save-draft">Lưu nháp</button>
        <button class="btn btn--primary" type="button" id="save-publish">Xuất bản</button>
      </div>
    </form>

    <div class="admin-quick-product" style="margin-top: 1.25rem;">
      <p style="margin: 0; font-weight: 600;">Thêm sản phẩm nhanh</p>
      <p class="admin-hint">Tạo product mới và tự gắn vào bài đang soạn — không cần rời trang.</p>
      <div id="quick-product-form">
        <div class="admin-form__row">
          <input name="name" id="qp-name" required placeholder="Tên sản phẩm" style="flex: 1.4;" />
          <input name="slug" id="qp-slug" placeholder="slug (tuỳ chọn)" style="flex: 1;" />
          <input name="category" id="qp-category" placeholder="category" value="khac" style="flex: 0.8;" />
          <input name="price_hint" id="qp-price" placeholder="Giá gợi ý" style="flex: 0.8;" />
          <input
            name="affiliate_url"
            id="qp-aff"
            placeholder="Affiliate URL (tuỳ chọn)"
            style="flex: 1.2;"
          />
          <button class="btn btn--ghost" type="button" id="qp-submit">Thêm</button>
        </div>
      </div>
    </div>
</AdminLayout>

<script>
  import { initPostEditor } from '../../../scripts/admin-post-editor';
  initPostEditor({ mode: 'create' });
</script>
