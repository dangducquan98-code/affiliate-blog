---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { requireAdmin } from '../../../lib/admin-auth';
import { listProductsAdmin } from '../../../lib/products';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const { products: catalog, error: catalogError, tableMissing } = await listProductsAdmin();
const catalogJson = JSON.stringify(
  catalog.map((p) => ({
    slug: p.slug,
    name: p.name,
    price_hint: p.price_hint,
  })),
);
---

<BaseLayout
  title="Viết bài mới"
  description="Tạo bài viết mới"
  canonicalPath="/admin/posts/new"
  hideChrome={true}
>
  <section class="admin-shell">
    <div class="admin-bar">
      <h1 style="margin: 0;">Viết bài mới</h1>
      <a class="btn btn--ghost" href="/admin">← Danh sách</a>
    </div>
    <p id="error" class="admin-error" hidden></p>
    {
      (catalogError || tableMissing) && (
        <p class="fallback-notice">
          {catalogError ||
            'Bảng products chưa có — chạy migration rồi gắn sản phẩm từ catalog.'}
        </p>
      )
    }
    <form id="post-form" class="admin-form">
      <label>
        Tiêu đề
        <input name="title" required />
      </label>
      <label>
        Slug (URL)
        <input name="slug" placeholder="tu-dong-tu-tieu-de" />
      </label>
      <label>
        Mô tả (SEO)
        <textarea name="description" style="min-height: 5rem;" required></textarea>
      </label>
      <label>
        Category
        <input name="category" value="review" required />
      </label>
      <label>
        Tags (phẩy)
        <input name="tags" placeholder="hub, UGREEN, review" />
      </label>
      <label>
        Cover image path/URL
        <input name="cover_image" id="cover_image" placeholder="ten-file.jpg hoặc URL" />
      </label>
      <div class="admin-form__row">
        <input type="file" id="cover_file" accept="image/*" />
        <button class="btn btn--ghost" type="button" id="upload-cover">Upload ảnh cover</button>
      </div>
      <label>
        Nội dung Markdown
        <textarea name="content" required placeholder="Viết Markdown thuần..."></textarea>
      </label>
      <div>
        <p style="font-weight: 600; margin: 0 0 0.5rem;">Sản phẩm từ catalog</p>
        <p style="margin: 0 0 0.75rem; color: var(--ink-muted); font-size: 0.92rem;">
          Chọn slug có sẵn — lưu dạng <code>{`{ "slug": "..." }`}</code>.
          {
            catalog.length === 0 && (
              <>
                {' '}
                <a href="/admin/products">Thêm sản phẩm trước →</a>
              </>
            )
          }
        </p>
        <div id="products" class="admin-products-pick" data-catalog={catalogJson} data-selected="[]"></div>
      </div>
      <label class="admin-form__row" style="font-weight: 600;">
        <input type="checkbox" name="published" />
        Publish ngay
      </label>
      <div class="admin-form__row">
        <button class="btn btn--primary" type="submit">Lưu bài</button>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  type CatalogItem = { slug: string; name: string; price_hint: string };

  const productsEl = document.getElementById('products');
  const form = document.getElementById('post-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('error');
  const uploadBtn = document.getElementById('upload-cover');
  const coverInput = document.getElementById('cover_image') as HTMLInputElement | null;
  const coverFile = document.getElementById('cover_file') as HTMLInputElement | null;

  const catalog: CatalogItem[] = productsEl?.dataset.catalog
    ? JSON.parse(productsEl.dataset.catalog)
    : [];
  const selected = new Set<string>(
    productsEl?.dataset.selected ? JSON.parse(productsEl.dataset.selected) : [],
  );

  function renderCatalog() {
    if (!productsEl) return;
    if (catalog.length === 0) {
      productsEl.innerHTML = '<p class="fallback-notice">Catalog trống.</p>';
      return;
    }
    productsEl.innerHTML = catalog
      .map(
        (p) => `
      <label class="admin-products-pick__item">
        <input type="checkbox" data-slug="${p.slug}" ${selected.has(p.slug) ? 'checked' : ''} />
        <span>
          <strong>${p.name}</strong>
          <code>${p.slug}</code>
          ${p.price_hint ? `<span class="muted">${p.price_hint}</span>` : ''}
        </span>
      </label>`,
      )
      .join('');
  }

  function readProducts(): { slug: string }[] {
    if (!productsEl) return [];
    return [...productsEl.querySelectorAll<HTMLInputElement>('input[data-slug]:checked')].map(
      (input) => ({ slug: input.dataset.slug || '' }),
    ).filter((p) => p.slug);
  }

  renderCatalog();

  uploadBtn?.addEventListener('click', async () => {
    if (!coverFile?.files?.[0]) {
      alert('Chọn file ảnh trước.');
      return;
    }
    const body = new FormData();
    body.append('file', coverFile.files[0]);
    const res = await fetch('/api/admin/upload', { method: 'POST', body });
    const payload = await res.json().catch(() => ({}));
    if (!res.ok) {
      alert(payload.error || 'Upload thất bại');
      return;
    }
    if (coverInput) coverInput.value = payload.path || payload.url || '';
    alert('Upload OK. Path đã điền vào cover.');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }
    const data = new FormData(form);
    const payload = {
      title: String(data.get('title') || ''),
      slug: String(data.get('slug') || ''),
      description: String(data.get('description') || ''),
      category: String(data.get('category') || ''),
      tags: String(data.get('tags') || ''),
      cover_image: String(data.get('cover_image') || ''),
      content: String(data.get('content') || ''),
      published: (form.elements.namedItem('published') as HTMLInputElement).checked,
      products: readProducts(),
    };

    const res = await fetch('/api/admin/posts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = result.error || 'Lưu thất bại.';
      }
      return;
    }
    window.location.href = `/admin/posts/${result.post.id}`;
  });
</script>
