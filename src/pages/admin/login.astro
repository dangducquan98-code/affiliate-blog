---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readAdminSession } from '../../lib/admin-auth';
import '../../styles/admin.css';

if (readAdminSession(Astro.cookies)) {
  return Astro.redirect('/admin');
}
---

<BaseLayout
  title="Đăng nhập Admin"
  description="Đăng nhập quản trị Quân Kiu Daily"
  canonicalPath="/admin/login"
  hideChrome={true}
>
  <div id="admin-nav-progress" class="admin-nav-progress" hidden aria-hidden="true"></div>
  <div class="admin-login-page">
    <section class="admin-login-wrap">
      <p class="admin-login-wrap__brand">Quân Kiu Admin</p>
      <h1>Đăng nhập</h1>
      <p class="admin-hint" style="margin-bottom: 1rem;">
        Quản lý bài viết và sản phẩm affiliate.
      </p>
      <p id="error" class="admin-error" hidden></p>
      <form id="login-form" class="admin-form">
        <label>
          Mật khẩu
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <div class="admin-form__row">
          <button class="btn btn--primary" type="submit">Đăng nhập</button>
          <a class="btn btn--ghost" href="/">Về trang chủ</a>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { initAdminNavigation } from '../../scripts/admin-navigation';

  initAdminNavigation();

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }

    const data = new FormData(form);
    const password = String(data.get('password') || '');
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang đăng nhập…';
    }
    document.getElementById('admin-nav-progress')?.classList.add('is-active');
    document.querySelector('.admin-login-page')?.classList.add('is-navigating');

    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });

    if (!res.ok) {
      const payload = await res.json().catch(() => ({}));
      document.getElementById('admin-nav-progress')?.classList.remove('is-active');
      document.querySelector('.admin-login-page')?.classList.remove('is-navigating');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Đăng nhập';
      }
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = payload.error || 'Mật khẩu không đúng. Thử lại.';
      }
      return;
    }

    window.location.href = '/admin';
  });
</script>
