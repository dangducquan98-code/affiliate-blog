---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { requireAdmin } from '../../../lib/admin-auth';
import { getProductByIdAdmin } from '../../../lib/products';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const id = Astro.params.id ?? '';
const { product, error, tableMissing } = await getProductByIdAdmin(id);

if (!product && !error && !tableMissing) {
  Astro.response.status = 404;
}
---

<BaseLayout
  title={product ? `Sửa: ${product.name}` : 'Không tìm thấy sản phẩm'}
  description="Sửa sản phẩm catalog"
  canonicalPath={`/admin/products/${id}`}
  hideChrome={true}
>
  <section class="admin-shell">
    {
      !product ? (
        <div>
          <h1>Không tải được sản phẩm</h1>
          <p class="fallback-notice">
            {error || (tableMissing ? 'Bảng products chưa tồn tại.' : 'Sản phẩm không tồn tại.')}
          </p>
          <a class="btn btn--ghost" href="/admin/products">
            ← Quay lại
          </a>
        </div>
      ) : (
        <>
          <div class="admin-bar">
            <div>
              <h1 style="margin: 0;">Sửa sản phẩm</h1>
              <p style="margin: 0.35rem 0 0; color: var(--ink-muted);">
                /go/<code>{product.slug}</code>
                {' · '}
                <span
                  class={`admin-badge ${product.affiliate_url ? 'admin-badge--ok' : 'admin-badge--warn'}`}
                >
                  {product.affiliate_url ? 'Đã dán affiliate' : 'Trống affiliate'}
                </span>
              </p>
            </div>
            <a class="btn btn--ghost" href="/admin/products">
              ← Quay lại
            </a>
          </div>
          <p id="error" class="admin-error" hidden></p>
          <form id="product-form" class="admin-form" data-id={product.id}>
            <label>
              Tên *
              <input name="name" required value={product.name} />
            </label>
            <label>
              Slug (khớp /go) *
              <input name="slug" required value={product.slug} />
            </label>
            <label>
              Category *
              <input name="category" required value={product.category} />
            </label>
            <label>
              Giá gợi ý
              <input name="price_hint" value={product.price_hint} />
            </label>
            <label>
              Affiliate URL (Shopee)
              <input name="affiliate_url" type="url" value={product.affiliate_url ?? ''} />
            </label>
            <label>
              Image path/URL (optional)
              <input name="image" value={product.image ?? ''} />
            </label>
            <div class="admin-form__actions">
              <button class="btn btn--primary" type="submit" id="save-btn">
                Lưu thay đổi
              </button>
              <button class="btn btn--danger" type="button" id="delete-product">
                Xoá
              </button>
            </div>
          </form>
        </>
      )
    }
  </section>
</BaseLayout>

{
  product && (
    <script>
      import { showToast, setLoading } from '../../../scripts/admin-shared';

      const form = document.getElementById('product-form') as HTMLFormElement | null;
      const errorEl = document.getElementById('error');
      const deleteBtn = document.getElementById('delete-product') as HTMLButtonElement | null;
      const saveBtn = document.getElementById('save-btn') as HTMLButtonElement | null;
      const productId = form?.dataset.id || '';

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
        const data = new FormData(form);
        const payload = {
          name: String(data.get('name') || ''),
          slug: String(data.get('slug') || ''),
          category: String(data.get('category') || ''),
          price_hint: String(data.get('price_hint') || ''),
          affiliate_url: String(data.get('affiliate_url') || ''),
          image: String(data.get('image') || ''),
        };

        setLoading(saveBtn, true, 'Đang lưu…');
        const res = await fetch(`/api/admin/products/${productId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json().catch(() => ({}));
        setLoading(saveBtn, false);
        if (!res.ok) {
          const msg = result.error || 'Lưu thất bại.';
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = msg;
          }
          showToast(msg, 'err');
          return;
        }
        showToast('Đã lưu sản phẩm.');
      });

      deleteBtn?.addEventListener('click', async () => {
        if (!confirm('Xoá sản phẩm này?')) return;
        setLoading(deleteBtn, true, 'Đang xoá…');
        const res = await fetch(`/api/admin/products/${productId}`, { method: 'DELETE' });
        setLoading(deleteBtn, false);
        if (!res.ok) {
          showToast('Xoá thất bại.', 'err');
          return;
        }
        showToast('Đã xoá.');
        window.location.href = '/admin/products';
      });
    </script>
  )
}
