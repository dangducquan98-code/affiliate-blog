---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/admin-auth';
import { listProductsAdmin } from '../../../lib/products';
import { isSupabaseServiceConfigured } from '../../../lib/supabase';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const configured = isSupabaseServiceConfigured();
const result = configured
  ? await listProductsAdmin()
  : {
      products: [],
      error: 'Supabase service role chưa cấu hình.',
      tableMissing: false,
    };

const productsJson = JSON.stringify(
  result.products.map((p) => ({
    id: p.id,
    name: p.name,
    slug: p.slug,
    category: p.category,
    price_hint: p.price_hint,
    has_affiliate: Boolean(p.affiliate_url),
  })),
);
---

<AdminLayout
  title="Sản phẩm"
  description="Catalog sản phẩm affiliate"
  canonicalPath="/admin/products"
  activeNav="products"
  wide={true}
>
  <p slot="lead">
    Dán link Shopee vào <code>affiliate_url</code> trước khi publish bài gắn sản phẩm.
    Badge vàng = <strong>chưa dán link</strong> (publish sẽ bị chặn).
  </p>
  <div slot="actions">
    <a class="btn btn--primary" href="/admin/products/new">Thêm sản phẩm</a>
  </div>

  {result.error && <p class="fallback-notice">{result.error}</p>}
  {
    result.tableMissing && (
      <p class="fallback-notice">
        Migration chưa chạy: <code>supabase/migrations/20260826_products.sql</code>
      </p>
    )
  }

  <div class="admin-toolbar">
    <input id="product-search" type="search" placeholder="Tìm theo tên / slug…" autocomplete="off" />
    <select id="affiliate-filter" aria-label="Lọc affiliate">
      <option value="all">Tất cả link</option>
      <option value="ok">Đã dán affiliate</option>
      <option value="empty">Còn trống</option>
    </select>
  </div>

  {
    !result.error && result.products.length === 0 && (
      <p class="fallback-notice">
        Chưa có sản phẩm. <a href="/admin/products/new">Thêm mới</a> hoặc chạy seed trong migration.
      </p>
    )
  }

  {
    result.products.length > 0 && (
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Tên</th>
              <th>Slug</th>
              <th>Category</th>
              <th>Giá</th>
              <th>Affiliate</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody id="products-tbody" data-products={productsJson}></tbody>
        </table>
      </div>
    )
  }
  <p id="products-empty-filter" class="fallback-notice" hidden>Không có sản phẩm khớp bộ lọc.</p>
</AdminLayout>

<script>
  import { showToast, setLoading } from '../../../scripts/admin-shared';

  type Row = {
    id: string;
    name: string;
    slug: string;
    category: string;
    price_hint: string;
    has_affiliate: boolean;
  };

  const tbody = document.getElementById('products-tbody');
  const searchEl = document.getElementById('product-search') as HTMLInputElement | null;
  const filterEl = document.getElementById('affiliate-filter') as HTMLSelectElement | null;
  const emptyFilter = document.getElementById('products-empty-filter');
  const all: Row[] = tbody?.dataset.products ? JSON.parse(tbody.dataset.products) : [];

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function filtered(): Row[] {
    const q = (searchEl?.value || '').trim().toLowerCase();
    const aff = filterEl?.value || 'all';
    return all.filter((p) => {
      if (aff === 'ok' && !p.has_affiliate) return false;
      if (aff === 'empty' && p.has_affiliate) return false;
      if (
        q &&
        !p.name.toLowerCase().includes(q) &&
        !p.slug.toLowerCase().includes(q) &&
        !(p.category || '').toLowerCase().includes(q)
      ) {
        return false;
      }
      return true;
    });
  }

  function render() {
    if (!tbody) return;
    const rows = filtered();
    if (emptyFilter) emptyFilter.hidden = rows.length > 0 || all.length === 0;
    tbody.innerHTML = rows
      .map(
        (p) => `
      <tr>
        <td><a href="/admin/products/${p.id}">${escapeHtml(p.name)}</a></td>
        <td><code>${escapeHtml(p.slug)}</code></td>
        <td>${escapeHtml(p.category || '—')}</td>
        <td>${escapeHtml(p.price_hint || '—')}</td>
        <td>
          <span class="admin-badge ${p.has_affiliate ? 'admin-badge--ok' : 'admin-badge--warn'}">
            ${p.has_affiliate ? 'Đã dán' : '⚠ Chưa dán link'}
          </span>
        </td>
        <td>
          <div class="admin-table__actions">
            <a class="btn btn--ghost" href="/admin/products/${p.id}">Sửa</a>
            <a class="btn btn--ghost" href="/go/${escapeHtml(p.slug)}" target="_blank" rel="noreferrer">Test</a>
            <button class="btn btn--danger" type="button" data-delete="${p.id}">Xoá</button>
          </div>
        </td>
      </tr>`,
      )
      .join('');
  }

  searchEl?.addEventListener('input', render);
  filterEl?.addEventListener('change', render);

  tbody?.addEventListener('click', async (event) => {
    const btn = (event.target as HTMLElement | null)?.closest(
      'button[data-delete]',
    ) as HTMLButtonElement | null;
    if (!btn) return;
    const id = btn.dataset.delete || '';
    const product = all.find((p) => p.id === id);
    if (!id || !confirm(`Xoá sản phẩm “${product?.name || id}”?`)) return;
    setLoading(btn, true, 'Đang xoá…');
    const res = await fetch(`/api/admin/products/${id}`, { method: 'DELETE' });
    if (!res.ok) {
      setLoading(btn, false);
      showToast('Xoá thất bại.', 'err');
      return;
    }
    const idx = all.findIndex((p) => p.id === id);
    if (idx >= 0) all.splice(idx, 1);
    showToast('Đã xoá sản phẩm.');
    render();
  });

  render();
</script>
