---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/admin-auth';
import { productCategoryOptions } from '../../../lib/product-categories';

if (!requireAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const categoryOptions = productCategoryOptions();
---

<AdminLayout
  title="Thêm sản phẩm"
  description="Tạo sản phẩm catalog"
  canonicalPath="/admin/products/new"
  activeNav="products"
>
  <div slot="actions">
    <a class="btn btn--ghost" href="/admin/products">← Danh sách</a>
  </div>
  <p id="error" class="admin-error" hidden></p>
  <form id="product-form" class="admin-form">
    <label>
      Tên *
      <input name="name" required placeholder="Mic Boya BY-M1" />
    </label>
    <label>
      Slug (khớp /go)
      <input name="slug" placeholder="tu-dong-tu-ten" />
    </label>
    <label>
      Category *
      <select name="category" required>
        {categoryOptions.map((c) => (
          <option value={c.value} selected={c.value === 'khac'}>
            {c.label}
          </option>
        ))}
      </select>
    </label>
    <label>
      Giá gợi ý
      <input name="price_hint" placeholder="~150–250k" />
    </label>
    <label>
      Affiliate URL (Shopee)
      <input name="affiliate_url" type="url" placeholder="https://s.shopee.vn/..." />
      <span class="admin-hint">Nên dán ngay — thiếu link thì không publish được bài gắn SP.</span>
    </label>
    <label>
      Image path/URL (optional)
      <input name="image" placeholder="ten-file.jpg hoặc URL" />
    </label>
    <div class="admin-form__actions">
      <button class="btn btn--primary" type="submit" id="save-btn">Lưu sản phẩm</button>
      <a class="btn btn--ghost" href="/admin/products">← Quay lại</a>
    </div>
  </form>
</AdminLayout>

<script>
  import { affiliateUrlError } from '../../../lib/affiliate-url';
  import { showToast, setLoading } from '../../../scripts/admin-shared';

  const form = document.getElementById('product-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('error');
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    }
    const data = new FormData(form);
    const affiliate_url = String(data.get('affiliate_url') || '');
    const affErr = affiliateUrlError(affiliate_url);
    if (affErr) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = affErr;
      }
      showToast(affErr, 'err');
      return;
    }
    const payload = {
      name: String(data.get('name') || ''),
      slug: String(data.get('slug') || ''),
      category: String(data.get('category') || ''),
      price_hint: String(data.get('price_hint') || ''),
      affiliate_url,
      image: String(data.get('image') || ''),
    };

    setLoading(saveBtn, true, 'Đang lưu…');
    const res = await fetch('/api/admin/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const result = await res.json().catch(() => ({}));
    setLoading(saveBtn, false);
    if (!res.ok) {
      const msg = result.error || 'Lưu thất bại.';
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = msg;
      }
      showToast(msg, 'err');
      return;
    }
    showToast('Đã tạo sản phẩm.');
    window.location.href = `/admin/products/${result.product.id}`;
  });
</script>
